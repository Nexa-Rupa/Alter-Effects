{
  "name": "altereffects",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "description": "Alter Effects — editorial motion-graphics videos from an organisation's own content, with any AI provider.",
  "homepage": "https://github.com/Nexa-Rupa/Alter-Effects#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nexa-Rupa/Alter-Effects.git"
  },
  "bugs": {
    "url": "https://github.com/Nexa-Rupa/Alter-Effects/issues"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "infra:up": "docker compose up -d postgres s3",
    "infra:down": "docker compose down",
    "db:push": "node --env-file=.env node_modules/prisma/build/index.js db push --schema packages/db/prisma/schema.prisma",
    "db:generate": "npm run generate -w @altereffects/db",
    "dev": "concurrently -n web,worker -c blue,green \"npm run dev -w @altereffects/web\" \"npm run dev -w @altereffects/worker\"",
    "dev:web": "npm run dev -w @altereffects/web",
    "dev:worker": "npm run dev -w @altereffects/worker",
    "build": "npm run build -w @altereffects/web",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "npm run test -w @altereffects/engine && tsx apps/web/src/tools/captions.test.ts && tsx packages/fx/src/index.test.ts",
    "render:sample": "npm run sample -w @altereffects/engine",
    "db:studio": "node --env-file=.env node_modules/prisma/build/index.js studio --schema packages/db/prisma/schema.prisma",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.10.0",
    "concurrently": "^10.0.7",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true
  }
}
