# ---------- Core ----------
# Postgres. Neon: console.neon.tech → your project → Connect → copy the connection string.
# Use the DIRECT host (no "-pooler" in it) and keep ?sslmode=require. Jobs and rate limits also live here (no Redis).
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-xxxx.REGION.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://altereffects:altereffects@localhost:5433/altereffects

APP_URL=http://localhost:3000

# Auth.js secret (generate: `npx auth secret` or any 32+ random chars)
AUTH_SECRET=change-me-to-a-long-random-string

# Master key that encrypts customers' AI provider keys (32 bytes, base64).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
KEY_ENCRYPTION_KEY=

# ---------- Object storage (Cloudflare R2 / S3, or RustFS locally) ----------
# Cloudflare R2: dash.cloudflare.com → R2 → Create bucket (e.g. altereffects), then
# R2 → Manage API tokens → Create token with "Object Read & Write" on that bucket.
#   S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
#   S3_REGION=auto
#   S3_BUCKET=altereffects
#   S3_ACCESS_KEY_ID=<token Access Key ID>
#   S3_SECRET_ACCESS_KEY=<token Secret Access Key>
#   S3_FORCE_PATH_STYLE=true
# Also add a CORS policy on the bucket (Settings → CORS) allowing GET and PUT from APP_URL, so browsers can upload and play media.
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=altereffects
S3_ACCESS_KEY_ID=altereffects
S3_SECRET_ACCESS_KEY=altereffects-secret
S3_FORCE_PATH_STYLE=true

# ---------- Rendering ----------
# Local Chrome/Chromium used by the render + screenshot workers
CHROME_PATH=C:/Program Files/Google/Chrome/Application/chrome.exe
FFMPEG_PATH=ffmpeg
# Python used for video effects (needs: pip install -r packages/fx/requirements.txt). Default: python3 (python on Windows).
# FX_PYTHON=python3
# EFFECTS_CONCURRENCY=1
FFPROBE_PATH=ffprobe
WORK_DIR=./.work
RENDER_FPS=30

# ---------- Managed AI (optional platform default; customers can bring their own keys) ----------
# Set a key for any providers you want. Every configured provider joins a fallback chain:
# if one fails (bad key, rate limit, outage) the next is tried. Order with MANAGED_PROVIDERS
# (comma list of anthropic, openai, gemini, openrouter, custom); leave empty to use all configured.
MANAGED_PROVIDERS=

# Anthropic (Claude): console.anthropic.com → API keys, e.g. the key named "altereffects"
ALTEREFFECTS_ANTHROPIC_API_KEY=
MANAGED_ANTHROPIC_MODEL_STRONG=claude-opus-5-5
MANAGED_ANTHROPIC_MODEL_CHEAP=claude-opus-5-5

# OpenAI: platform.openai.com → API keys (use vision-capable model ids)
ALTEREFFECTS_OPENAI_API_KEY=
MANAGED_OPENAI_MODEL_STRONG=
MANAGED_OPENAI_MODEL_CHEAP=

# Google Gemini: aistudio.google.com → Get API key
ALTEREFFECTS_GEMINI_API_KEY=
MANAGED_GEMINI_MODEL_STRONG=
MANAGED_GEMINI_MODEL_CHEAP=

# OpenRouter (hundreds of models behind one key): openrouter.ai → Keys. Model ids look like vendor/model.
ALTEREFFECTS_OPENROUTER_API_KEY=
MANAGED_OPENROUTER_MODEL_STRONG=
MANAGED_OPENROUTER_MODEL_CHEAP=

# Custom OpenAI-compatible router or server: 9Router (http://localhost:20128/v1), LiteLLM (http://localhost:4000/v1),
# Ollama (http://localhost:11434/v1), LM Studio (http://localhost:1234/v1), Groq, DeepSeek, Together, Mistral, xAI…
# The key is optional for local routers. The model can be a router "combo" name.
MANAGED_CUSTOM_BASE_URL=
ALTEREFFECTS_CUSTOM_API_KEY=
MANAGED_CUSTOM_MODEL_STRONG=
MANAGED_CUSTOM_MODEL_CHEAP=

# ---------- Razorpay (TEST MODE keys from dashboard.razorpay.com → Settings → API Keys) ----------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---------- Email (password reset + team invites) ----------
# Any SMTP provider (Resend, Postmark, SES, Mailgun, Gmail…). Leave empty in development:
# emails are then printed to the server log instead of sent.
# Example: smtps://USERNAME:PASSWORD@smtp.resend.com:465
SMTP_URL=
MAIL_FROM="Alter Effects <no-reply@example.com>"

# ---------- Security ----------
# Rate limits key on the client IP from X-Forwarded-For / CF-Connecting-IP. Set to false if the app is
# reachable directly (no reverse proxy), so clients can't spoof those headers.
TRUST_PROXY=true
# Extra origins allowed by the Content-Security-Policy for images/media (e.g. a CDN in front of storage).
# Read at build time, like S3_ENDPOINT.
CSP_EXTRA_ORIGINS=

# Storage address browsers use for media links, when it differs from S3_ENDPOINT
# (e.g. Docker: S3_ENDPOINT=http://s3:9000, S3_PUBLIC_ENDPOINT=http://localhost:9000). Read at build time for the CSP.
S3_PUBLIC_ENDPOINT=
